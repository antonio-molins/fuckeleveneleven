---
// The wish box, styled as a story reply bar. It never accepts a wish; see src/lib/sabotage.
---

<div class="wish">
	<p class="wish-status" data-wish-status role="status" aria-live="polite"></p>
	<form class="wish-form" data-wish-form autocomplete="off">
		<label class="visually-hidden" for="wish">Your wish</label>
		<input id="wish" name="wish" type="text" maxlength="280" placeholder="Make a wish…" data-wish-input />
		<button type="submit" class="wish-send" aria-label="Send wish" data-wish-submit>
			<svg class="wish-send-icon" viewBox="0 0 26 24" aria-hidden="true">
				<defs>
					<!-- First half of each orbit runs along the bottom (in front of the plane), second half along the top (behind). -->
					<path id="send-orbit-a" d="M-0.3 10A15 6 0 0 0 29.7 10A15 6 0 0 0 -0.3 10" />
					<path id="send-orbit-b" d="M1.7 10A13 5 0 0 0 27.7 10A13 5 0 0 0 1.7 10" />
				</defs>
				<!-- The plane's visual centre (its centroid) sits up and right of its box; this pulls it to the middle. -->
				<g transform="translate(-1.7 2)">
					<!-- Each star is drawn twice: under the plane for the back half of its orbit, over it for the front half. -->
					<g class="wish-send-orbit" transform="rotate(-28 14.7 10)">
						<g opacity="0">
							<animateMotion dur="2.4s" begin="-0.00s" repeatCount="indefinite"><mpath href="#send-orbit-a" /></animateMotion>
							<animate attributeName="opacity" values="0;0.6" keyTimes="0;0.5" calcMode="discrete" dur="2.4s" begin="-0.00s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -4.6Q0 0 4.6 0Q0 0 0 4.6Q0 0 -4.6 0Q0 0 0 -4.6Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="0.9s" begin="-0.00s" repeatCount="indefinite" />
							</path>
						</g>
						<g opacity="0">
							<animateMotion dur="2.4s" begin="-1.20s" repeatCount="indefinite"><mpath href="#send-orbit-a" /></animateMotion>
							<animate attributeName="opacity" values="0;0.6" keyTimes="0;0.5" calcMode="discrete" dur="2.4s" begin="-1.20s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -3Q0 0 3 0Q0 0 0 3Q0 0 -3 0Q0 0 0 -3Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="0.7s" begin="-1.20s" repeatCount="indefinite" />
							</path>
						</g>
					</g>
					<g class="wish-send-orbit" transform="rotate(32 14.7 10)">
						<g opacity="0">
							<animateMotion dur="3.4s" begin="-0.85s" repeatCount="indefinite"><mpath href="#send-orbit-b" /></animateMotion>
							<animate attributeName="opacity" values="0;0.6" keyTimes="0;0.5" calcMode="discrete" dur="3.4s" begin="-0.85s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -3.8Q0 0 3.8 0Q0 0 0 3.8Q0 0 -3.8 0Q0 0 0 -3.8Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="1.1s" begin="-0.85s" repeatCount="indefinite" />
							</path>
						</g>
						<g opacity="0">
							<animateMotion dur="3.4s" begin="-2.55s" repeatCount="indefinite"><mpath href="#send-orbit-b" /></animateMotion>
							<animate attributeName="opacity" values="0;0.6" keyTimes="0;0.5" calcMode="discrete" dur="3.4s" begin="-2.55s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -2.5Q0 0 2.5 0Q0 0 0 2.5Q0 0 -2.5 0Q0 0 0 -2.5Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="0.8s" begin="-2.55s" repeatCount="indefinite" />
							</path>
						</g>
					</g>
					<path class="wish-send-plane" d="M24 2 17 21l-6-10-8-4 21-5ZM24 2 11 11" />
					<g class="wish-send-orbit" transform="rotate(-28 14.7 10)">
						<g opacity="0">
							<animateMotion dur="2.4s" begin="-0.00s" repeatCount="indefinite"><mpath href="#send-orbit-a" /></animateMotion>
							<animate attributeName="opacity" values="1;0" keyTimes="0;0.5" calcMode="discrete" dur="2.4s" begin="-0.00s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -4.6Q0 0 4.6 0Q0 0 0 4.6Q0 0 -4.6 0Q0 0 0 -4.6Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="0.9s" begin="-0.00s" repeatCount="indefinite" />
							</path>
						</g>
						<g opacity="0">
							<animateMotion dur="2.4s" begin="-1.20s" repeatCount="indefinite"><mpath href="#send-orbit-a" /></animateMotion>
							<animate attributeName="opacity" values="1;0" keyTimes="0;0.5" calcMode="discrete" dur="2.4s" begin="-1.20s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -3Q0 0 3 0Q0 0 0 3Q0 0 -3 0Q0 0 0 -3Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="0.7s" begin="-1.20s" repeatCount="indefinite" />
							</path>
						</g>
					</g>
					<g class="wish-send-orbit" transform="rotate(32 14.7 10)">
						<g opacity="0">
							<animateMotion dur="3.4s" begin="-0.85s" repeatCount="indefinite"><mpath href="#send-orbit-b" /></animateMotion>
							<animate attributeName="opacity" values="1;0" keyTimes="0;0.5" calcMode="discrete" dur="3.4s" begin="-0.85s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -3.8Q0 0 3.8 0Q0 0 0 3.8Q0 0 -3.8 0Q0 0 0 -3.8Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="1.1s" begin="-0.85s" repeatCount="indefinite" />
							</path>
						</g>
						<g opacity="0">
							<animateMotion dur="3.4s" begin="-2.55s" repeatCount="indefinite"><mpath href="#send-orbit-b" /></animateMotion>
							<animate attributeName="opacity" values="1;0" keyTimes="0;0.5" calcMode="discrete" dur="3.4s" begin="-2.55s" repeatCount="indefinite" />
							<path class="wish-send-sparkle" d="M0 -2.5Q0 0 2.5 0Q0 0 0 2.5Q0 0 -2.5 0Q0 0 0 -2.5Z">
								<animateTransform attributeName="transform" type="scale" values="0.6;1.2;0.6" dur="0.8s" begin="-2.55s" repeatCount="indefinite" />
							</path>
						</g>
					</g>
				</g>
				<g class="wish-send-still">
					<path class="wish-send-sparkle" d="M4.5 12.7Q4.5 16.5 8.3 16.5Q4.5 16.5 4.5 20.3Q4.5 16.5 0.7000000000000002 16.5Q4.5 16.5 4.5 12.7Z" />
					<path class="wish-send-sparkle" d="M10 18.8Q10 21.2 12.4 21.2Q10 21.2 10 23.599999999999998Q10 21.2 7.6 21.2Q10 21.2 10 18.8Z" />
					<path class="wish-send-sparkle" d="M23 16Q23 18 25 18Q23 18 23 20Q23 18 21 18Q23 18 23 16Z" />
				</g>
			</svg>
		</button>
	</form>
	<p class="wish-tip">
		<span data-tip-open>The universe is now accepting wishes. Response times may vary.</span>
		<span class="is-off" data-tip-denied>
			Wish denied. Unlike the universe, the Ko-fi below receives.
		</span>
	</p>
</div>

<dialog class="paywall" data-paywall aria-labelledby="paywall-title">
	<div data-paywall-step="pitch">
		<p class="paywall-badge">Wish Pro™</p>
		<h2 id="paywall-title">Your wish is <span data-over-by>0</span> characters over the free tier.</h2>
		<p>The free tier includes 0 characters. Wish Pro includes priority manifestation, a gratitude journal PDF and 11% off my next course.</p>
		<p class="paywall-price">$111.11 a month, billed every lunar cycle.</p>
		<div class="paywall-actions">
			<button type="button" class="paywall-upgrade" data-paywall-action="upgrade" data-goatcounter-click="wish-pro-upgrade"
				>Upgrade to Wish Pro</button
			>
			<button type="button" class="paywall-decline" data-paywall-action="decline">Keep my wish small</button>
		</div>
	</div>
	<div data-paywall-step="sold-out" hidden>
		<p class="paywall-badge">Wish Pro™</p>
		<h2>Wish Pro is sold out until Mercury leaves retrograde.</h2>
		<p>Join the waitlist by thinking about it really hard.</p>
		<div class="paywall-actions">
			<button type="button" class="paywall-decline" data-paywall-action="back">Back to wishing</button>
		</div>
	</div>
</dialog>

<script>
	import { GENERIC_REJECTIONS, pickSabotages, type Cleanup, type Sabotage, type WishElements } from '../lib/sabotage';
	import { flee, isCaught } from '../lib/sabotage/flee';
	import { track } from '../lib/track';

	const els: WishElements = {
		form: document.querySelector('[data-wish-form]')!,
		input: document.querySelector('[data-wish-input]')!,
		submit: document.querySelector('[data-wish-submit]')!,
		paywall: document.querySelector('[data-paywall]')!,
	};
	const status = document.querySelector<HTMLElement>('[data-wish-status]')!;
	const tipOpen = document.querySelector<HTMLElement>('[data-tip-open]')!;
	const tipDenied = document.querySelector<HTMLElement>('[data-tip-denied]')!;
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const pick = <T,>(items: T[]) => items[Math.floor(Math.random() * items.length)];

	let active: Sabotage[] = [];
	let cleanups: Cleanup[] = [];
	let busy = false;
	let attempts = 0;

	const showDenied = () => {
		tipOpen.classList.add('is-off');
		tipDenied.classList.remove('is-off');
	};

	function arm() {
		cleanups.forEach((cleanup) => cleanup());
		const previous = active.map((s) => s.id);
		active = pickSabotages(Math.random, { reducedMotion: reducedMotion.matches, previous });
		cleanups = active.flatMap((s) => (s.attach ? [s.attach(els)] : []));
		els.form.dataset.sabotage = active.map((s) => s.id).join(' ');
	}

	els.form.addEventListener('submit', async (event) => {
		// Nothing is ever sent anywhere. The wish dies right here, in your browser.
		event.preventDefault();
		if (busy) return;
		const wish = els.input.value.trim();
		if (!wish) {
			// Rejected like any other wish: everything resets, including a button that ran off.
			status.textContent = 'Empty wishes are a premium feature.';
			track('wish-denied-empty');
			els.input.value = '';
			arm();
			els.form.dataset.attempts = String(++attempts);
			showDenied();
			return;
		}

		busy = true;
		// If you caught the runaway button, the chase gets the last word; otherwise any active sabotage may.
		const caught = active.some((s) => s.id === 'flee') && isCaught(els.form);
		const rejecters = active.filter((s) => s.reject);
		const rejecter = caught ? flee : rejecters.length ? pick(rejecters) : null;
		status.textContent = rejecter ? await rejecter.reject!(wish, els) : pick(GENERIC_REJECTIONS);
		track(`wish-denied-${rejecter?.id ?? 'generic'}`);
		els.input.value = '';
		arm();
		els.form.dataset.attempts = String(++attempts);
		showDenied();
		busy = false;
	});

	arm();
</script>
