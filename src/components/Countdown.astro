---
// Live countdown to the next 11:11 anywhere. Rendered empty; the client script fills it in.
---

<section class="countdown" data-countdown aria-live="off">
	<p class="countdown-lead" data-countdown-lead>Next 11:11 hits</p>
	<p class="countdown-city" data-countdown-city>somewhere</p>
	<p class="countdown-local" data-countdown-local></p>
	<p class="countdown-clock" data-countdown-clock aria-label="time left">--:--:--</p>
	<p class="countdown-jab" data-countdown-jab></p>
</section>

<script>
	import cityCounts from '../data/cityCounts.json';
	import {
		citiesIn,
		getOffsets,
		headlineZone,
		indexCityCounts,
		meridiem,
		nextElevenEleven,
		prettyZone,
		type OffsetGroup,
	} from '../lib/elevenEleven';

	const COUNT_UP_MS = 2000;

	const root = document.querySelector<HTMLElement>('[data-countdown]')!;
	const lead = root.querySelector('[data-countdown-lead]')!;
	const city = root.querySelector('[data-countdown-city]')!;
	const local = root.querySelector('[data-countdown-local]')!;
	const clock = root.querySelector('[data-countdown-clock]')!;
	const jab = root.querySelector('[data-countdown-jab]')!;
	const progress = document.querySelector<HTMLElement>('[data-story-progress]');
	const html = document.documentElement;
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const cities = indexCityCounts(cityCounts);

	let groups: OffsetGroup[] = getOffsets(new Date());
	let lastTarget = 0;
	let localTime: Intl.DateTimeFormat | null = null;
	let otherCities = 0;
	let countUp = 0;

	const pad = (n: number) => String(n).padStart(2, '0');
	const hms = (ms: number) => {
		const s = Math.max(0, Math.ceil(ms / 1000));
		return `${pad(Math.floor(s / 3600))}:${pad(Math.floor((s % 3600) / 60))}:${pad(s % 60)}`;
	};

	const format = (n: number) => n.toLocaleString('en-US');

	// Counts the cities up from zero, in a slot already as wide as the final number so nothing shifts.
	// On the mobile intro it waits until the phone fades in.
	function animateCities() {
		cancelAnimationFrame(countUp);
		const total = otherCities;
		if (total <= 0) {
			jab.textContent = 'and nowhere else. Just them, alone, wishing.';
			return;
		}

		const slot = document.createElement('span');
		slot.className = 'jab-count';
		const final = document.createElement('span');
		final.className = 'jab-count-final';
		final.ariaHidden = 'true';
		final.textContent = format(total);
		const shown = document.createElement('span');
		slot.append(final, shown);
		jab.replaceChildren('and ', slot, total === 1 ? ' other city your guru has never been to.' : ' other cities your guru has never been to.');

		if (reducedMotion) {
			shown.textContent = format(total);
			return;
		}
		shown.textContent = '0';
		let start = 0;
		const step = (now: number) => {
			if (!(html.classList.contains('intro') && !html.classList.contains('intro-landing'))) {
				start ||= now;
				const t = Math.min(1, (now - start) / COUNT_UP_MS);
				shown.textContent = format(Math.round(total * (1 - (1 - t) ** 2)));
				if (t === 1) return;
			}
			countUp = requestAnimationFrame(step);
		};
		countUp = requestAnimationFrame(step);
	}

	function tick() {
		const now = Date.now();
		let next = nextElevenEleven(now, groups);
		if (next.targetUtcMs !== lastTarget) {
			// A new 11:11 is up; offsets may have shifted (DST), so regroup before trusting it.
			groups = getOffsets(new Date(now));
			next = nextElevenEleven(now, groups);
			lastTarget = next.targetUtcMs;

			const zone = headlineZone(next.groups);
			city.textContent = prettyZone(zone);
			localTime = new Intl.DateTimeFormat('en-US', { timeZone: zone, hour: 'numeric', minute: '2-digit' });
			otherCities = Math.max(0, citiesIn(next.groups, cities) - 1);
			if (!next.isNow) animateCities();
		}

		const zone = headlineZone(next.groups);
		const offset = next.groups.find((g) => g.zones.includes(zone))!.offsetMinutes;
		local.textContent = `It’s ${localTime!.format(now).toLowerCase()} there.`;
		document.body.classList.toggle('is-now', next.isNow);

		if (next.isNow) {
			cancelAnimationFrame(countUp);
			lead.textContent = `It’s 11:11 ${meridiem(next.targetUtcMs, offset)} right now in`;
			clock.textContent = hms(next.targetUtcMs + 60_000 - now).slice(3);
			jab.textContent = 'Wish. Now. Go. The portal closes when that hits zero.';
			progress?.style.setProperty('--progress', '1');
		} else {
			lead.textContent = `Next 11:11 ${meridiem(next.targetUtcMs, offset)} hits`;
			clock.textContent = hms(next.targetUtcMs - now);
			const span = next.targetUtcMs - next.previousUtcMs;
			progress?.style.setProperty('--progress', String((now - next.previousUtcMs) / span));
		}
	}

	tick();
	setInterval(tick, 250);
</script>
