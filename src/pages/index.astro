---
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/permanent-marker/400.css';
import '../styles/global.css';
import Countdown from '../components/Countdown.astro';
import WishForm from '../components/WishForm.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const description = 'The next 11:11 on Earth, a countdown to it, and a wish box that will not take your wish.';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Decide before first paint, so the story never flashes before the mobile intro.
			// Must come after the viewport meta: until then mobile browsers report a ~980px layout width.
			if (matchMedia('not all and (min-width: 60rem)').matches) {
				document.documentElement.classList.add('intro');
			}
		</script>
		<meta name="description" content={description} />
		<meta property="og:title" content="Fuck 11:11" />
		<meta property="og:description" content={description} />
		<meta name="theme-color" content="#2b1734" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>Fuck 11:11</title>
	</head>
	<body>
		<main class="stage">
			<article class="story" data-flee-area>
				<div class="story-progress" data-story-progress><span></span></div>
				<header class="story-head">
					<span class="story-avatar" aria-hidden="true">✨</span>
					<span class="story-handle">manifest.with.luna</span>
					<span class="story-age">11m</span>
				</header>

				<h1 class="hero" aria-label="Fuck 11:11">
					<span class="hero-time" aria-hidden="true">11:11</span>
					<span class="hero-wish" aria-hidden="true">
						make a wish ✨
						<svg class="hero-strike" viewBox="0 0 320 50" preserveAspectRatio="none" aria-hidden="true">
							<path pathLength="1" d="M4 30 C 40 12, 80 40, 120 20 S 200 38, 240 16 S 296 30, 316 22" />
						</svg>
					</span>
					<span class="hero-fuck" aria-hidden="true">fuck</span>
				</h1>

				<Countdown />
				<WishForm />
			</article>

			<aside class="manifesto" data-manifesto>
				<div class="manifesto-text">
					<p>11:11 is a time.</p>
					<p>It happens twice a day, in about forty time zones, forever.</p>
					<p>Nobody up there is taking requests.</p>
					<p>Want something? Go get it. Or don’t. Just stop selling it back to us.</p>
				</div>
			</aside>
		</main>

		<footer class="site-footer">
			<p>No wishes are stored, sent or read. This site has no server to send them to.</p>
		</footer>

		<script>
			// Mobile intro: the manifesto writes itself out, then the story slides up over it. Tap to skip.
			// With reduced motion the text appears at once, holds, and the story replaces it without sliding.
			const root = document.documentElement;
			const CHAR_MS = 18;
			const PARAGRAPH_PAUSE_MS = 260;
			const HOLD_MS = 700;
			const REDUCED_MOTION_HOLD_MS = 3000;

			if (root.classList.contains('intro')) {
				const manifesto = document.querySelector<HTMLElement>('[data-manifesto]')!;
				const story = document.querySelector<HTMLElement>('.story')!;
				const text = manifesto.querySelector<HTMLElement>('.manifesto-text')!;
				const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
				const chars = [...manifesto.querySelectorAll('.manifesto-text p')].flatMap((p) => {
					const spans = [...(p.textContent ?? '')].map((c) => {
						const span = document.createElement('span');
						span.className = 'manifesto-char';
						span.textContent = c;
						return span;
					});
					p.replaceChildren(...spans);
					spans.at(-1)!.dataset.pause = '';
					return spans;
				});

				let next = 0;
				let timer = 0;
				let landed = false;

				const finish = () => root.classList.remove('intro', 'intro-landing');
				const land = () => {
					if (landed) return;
					landed = true;
					clearTimeout(timer);
					chars.forEach((c) => c.classList.add('is-on'));
					root.classList.add('intro-landing');
					if (reducedMotion) return finish();
					story.addEventListener('transitionend', (e) => e.target === story && finish());
					timer = window.setTimeout(finish, 1500); // in case transitionend never fires
				};
				// Reveal against elapsed time rather than chained timers, so a busy phone doesn't slow the writing.
				const revealAt: number[] = [];
				let at = 0;
				for (const char of chars) {
					revealAt.push(at);
					at += 'pause' in char.dataset ? PARAGRAPH_PAUSE_MS : CHAR_MS;
				}
				let start = 0;
				const write = (now: number) => {
					if (landed) return;
					start ||= now;
					while (next < chars.length && revealAt[next] <= now - start) chars[next++].classList.add('is-on');
					if (next < chars.length) requestAnimationFrame(write);
					else timer = window.setTimeout(land, HOLD_MS);
				};

				manifesto.addEventListener('click', land);
				text.classList.add('is-typing');
				if (reducedMotion) {
					chars.forEach((c) => c.classList.add('is-on'));
					timer = window.setTimeout(land, REDUCED_MOTION_HOLD_MS);
				} else {
					requestAnimationFrame(write);
				}
			}
		</script>
	</body>
</html>
